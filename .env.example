# The Angular application itself (this directory) reads NO environment variables and has NO
# secrets: its only runtime configuration is the public, non-sensitive
# public/config/app-config.json (see docs/decisions/006-public-runtime-configuration.md).
#
# The variables below belong to the OPTIONAL reference backend in `server/`, which is NOT wired
# into the Angular build, the Docker image, or CI (see docs/decisions/007-form-backend.md). Copy
# this file to `server/.env` only if you choose to run that reference server yourself; never
# commit a real `.env` file.

# Port the reference API listens on.
PORT=3001

# Exact origin allowed to call the reference API via CORS. Never use "*" — a single explicit
# origin only.
ALLOWED_ORIGIN=http://localhost:4200

# --- Production runtime configuration (Coolify) -----------------------------------------------
# The Angular SSR server (src/server.ts) reads this to know which port to bind:
# PORT=4000
#
# If a real mailing provider were ever integrated into server/, its API key would be provided as
# a Coolify *runtime* environment variable — never as a Docker build argument, never committed
# here, and never exposed to the Angular bundle:
# MAILING_PROVIDER_API_KEY=
