{
  "name": "presta-mesta-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:coverage": "ng test -- --coverage",
    "test:e2e": "playwright test",
    "build:prod": "ng build --configuration production",
    "prerender": "ng build --configuration production",
    "serve:ssr:PrestaMesta_Web": "node dist/PrestaMesta_Web/server/server.mjs",
    "lint": "ng lint",
    "format": "prettier --write \"{src,tests,scripts,docs}/**/*.{ts,html,css,json,mjs,md}\" \"*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"{src,tests,scripts,docs}/**/*.{ts,html,css,json,mjs,md}\" \"*.{ts,js,json,md}\"",
    "generate:sitemap": "node scripts/generate-sitemap.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/platform-browser": "^22.1.0",
    "@angular/platform-server": "^22.1.0",
    "@angular/router": "^22.1.0",
    "@angular/ssr": "^22.1.2",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.2",
    "@angular/compiler-cli": "^22.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "angular-eslint": "22.1.0",
    "eslint": "^10.6.0",
    "jsdom": "^28.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.1.12",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.62.1",
    "vitest": "^4.0.8"
  }
}
